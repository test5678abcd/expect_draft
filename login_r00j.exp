#!/usr/bin/expect -f

#exp_internal 1

set timeout 20

source ./password_r00a.conf

# Shell prompt pattern
set prompt_pattern {\$ $}

# Login procedure
proc login {host user password options} {

    global prompt_pattern
    global spawn_id
    set ::env(TERM) vt100
    spawn ssh {*}$options $user@$host

    expect {
        -re {Are you sure you want to continue connecting.*\(yes/no\)} {
            send "yes\r"
            exp_continue
        }
        -re "(?i)password:" {
            send "$password\r"
            exp_continue
        }
        -re $prompt_pattern {
            puts "Login successful"
            return 1
        }
        timeout {
            puts "Login timeout"
            return 0
        }
        eof {
            puts "Connection failed"
            return 0
        }
    }
}

# Command execution procedure
proc cmd {command} {

    global prompt_pattern
    global spawn_id
    puts "Execute: $command"

    send -- "$command\r"

    expect {
        -re $prompt_pattern {
            return 1
        }
        timeout {
            puts "Command timeout"
            return 0
        }
        eof {
            puts "Connection lost"
            return 0
        }
    }
}

# Main process
if {[login $HOST $USER $PASSWORD $ssh_option]} {

    if {[cmd "hostname"] &&
        [cmd "whoami"] &&
        [cmd "date"]} {

        send "exit\r"
        expect eof

        puts "Logout completed"

    } else {

        send "exit\r"
        expect eof
    }
}

