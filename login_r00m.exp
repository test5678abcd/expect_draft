#!/usr/bin/expect -f

# 2026.11.26 thu r00k add permission denied to proc login
#                         proc _msg
#                         _script_name/_debug/_nodisplay/_verbose
#         28 sat r00m add _login_password/pshow/plain, fix proc name

 if {[info exists ::env(_debug)    ]} { exp_internal 1 }

 if {[info exists ::env(_nodisplay)]} { log_user 0      ;# does not display
 } else                               { log_user 1     };#          display as is

 if {[info exists ::env(_verbose)  ]} {set _verbose 1 } else {set _verbose 0}
 if {[info exists ::env(_pshow)    ]} {set _pshow   1 } else {set _pshow   0}

 set timeout 20
 set _script_name [file tail $argv0]

 proc _msg {_text} { global _verbose _script_name ; if {$_verbose} { puts "${_script_name}: $_text" } }

 set _host "192.168.179.211"
 set _user "h"
 set _ssh_options { -o UserKnownHostsFile=/dev/null -p 7022 }


 if {![info exists ::env(_plain)]}  {
  if {![info exists ::env(_pfile)]} { set    _pfile "./password_r00b.txt.asc"
  } else                            { set    _pfile $::env(_pfile) }
  if {![file exists     $_pfile]  } { _msg "_pfile $_pfile is not found." ; exit 1 }
  set env(_pfile_at_sh) $_pfile
  set _login_password [exec bash -o pipefail -c {gpg --quiet --decrypt $_pfile_at_sh | grep -vE '^[[:space:]]*(#|$)' | sed -n '1p'}]
 } else {
  if {![info exists ::env(_pfile)]} { set    _pfile "./password_r00b.txt" }
  if {![file exists     $_pfile]  } { error "_pfile $_pfile is not found."}
  set env(_pfile_at_sh) $_pfile
  set _login_password [exec bash -o pipefail -c {cat                   $_pfile_at_sh | grep -vE '^[[:space:]]*(#|$)' | sed -n '1p'}]
 }

 if {$_pshow  } { _msg "_login_password is $_login_password ." }
 if {$_verbose} { _msg "_pfile is $_pfile ."                   }

 # Shell prompt pattern
 set _prompt_pattern {\$ $}

 # Login procedure
 proc _login {host user password options} {

    global _prompt_pattern
    global spawn_id
    set ::env(TERM) vt100
    spawn ssh {*}$options $user@$host

    expect {
       -re {Are you sure you want to continue connecting.*\(yes/no\)} {
       send "yes\r"
       exp_continue
     } -re "(?i)password:" {
       send "$password\r"
       exp_continue
     } -re $_prompt_pattern {
        _msg "login successful"
        return 1
     } -re {Permission denied} {
        _msg "ERROR: Authentication failed, now send ctrl+c..."
        send -- "\003"
        expect eof
        return 0
     } timeout { _msg "timeout";return 0
     } eof     { _msg "eof"    ;return 0
     } } }

 # Command execution procedure
 proc _cmd {command} {
  global _prompt_pattern
  global spawn_id
  send -i $spawn_id -- "$command\r"
  expect {
   -i  $spawn_id
   -re $_prompt_pattern { return 1
   } timeout           { _msg "timeout";return 0
   } eof               { _msg "eof"    ;return 0
   } } }

 # Main process
 if {[_login $_host $_user $_login_password $_ssh_options]} {

    if {[_cmd "hostname"] &&
        [_cmd "whoami"] &&
        [_cmd "date"]} {

        send "exit\r"
        expect eof

        _msg "logout completed"

    } else {
        send "exit\r"
        expect eof
    }
 }

